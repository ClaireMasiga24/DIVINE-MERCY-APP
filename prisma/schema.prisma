generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  MEMBER
  SECRETARY
  TREASURER
  MOBILISER
  PRO
  CHAIRPERSON
  PATRON
  TECHNICAL_LEAD
}

enum Status {
  ACTIVE
  DEACTIVATED
}

enum EventType {
  RECOLLECTION
  HOLY_HOUR
  BENEDICTION
  HOLY_MASS
  MEETING
  PRAYER_MEETING
  NOVENA
  OTHER
}

enum MeetingType {
  VIDEO
  AUDIO
  IN_PERSON
}

enum RsvpStatus {
  ATTENDING
  MAYBE
  DECLINED
}

enum PrayerType {
  NOVENA
  CHAPLET
  ROSARY
  OTHER
}

enum NotificationType {
  EVENT
  MEETING
  PRAYER
  ANNOUNCEMENT
  SYSTEM
}

// Outcome of trying to ring one member for one Holy Hour call. Persisted so
// a phone that never rang is visible instead of silent — the push send used
// to swallow every error and discard the result.
enum HolyHourCallStatus {
  PENDING // logged, no delivery attempt recorded yet
  DELIVERED // at least one of the member's devices accepted the push
  NO_SUBSCRIPTION // the member has no usable push subscription to ring
  FAILED // every device we tried errored (retried, then given up on)
}

// ============================================================
// USERS & LEADERSHIP
// ============================================================

model User {
  id              String    @id @default(uuid())
  phoneNumber     String    @unique
  fullName        String
  email           String?   @unique
  passwordHash    String?
  profileImageUrl String?
  role            Role      @default(MEMBER)
  status          Status    @default(ACTIVE)
  devotionStart   DateTime?
  addedById       String?
  addedBy         User?     @relation("MemberInvites", fields: [addedById], references: [id])
  invitedUsers    User[]    @relation("MemberInvites")
  // Birthday, used by the alarm sweep (lib/alarms.ts fireBirthdays) to
  // fire a "🎂 It's <name>'s birthday today" notification to all active
  // members. Year + month + day — the table shows day + month only.
  birthday        DateTime?

  posts                    Post[]
  comments                 Comment[]
  eventAttendees           EventAttendee[]
  meetingParticipants      MeetingParticipant[]
  meetingSessions          MeetingSession[]
  meetingAttendances       MeetingAttendance[]
  reminders                Reminder[]
  notificationDeliveries   NotificationDelivery[]
  deviceTokens             DeviceToken[]
  holyHourCallLogs         HolyHourCallLog[]
  sessions                 Session[]
  createdEvents            Event[]
  createdMeetings          Meeting[]
  createdAnnouncements     Announcement[]
  createdNotifications     Notification[]
  settingsUpdated          AppSetting[]
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]

  meetingMusicPausedBy Meeting[] @relation("MeetingMusicPausedBy")
  meetingEndedBy       Meeting[] @relation("MeetingEndedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// APP SETTINGS (discussion toggle controlled by Chairperson / Technical Lead)
// ============================================================

model AppSetting {
  id                String   @id @default("global")
  discussionEnabled Boolean  @default(true)
  commentsEnabled   Boolean  @default(true)
  updatedById       String?
  updatedBy         User?    @relation(fields: [updatedById], references: [id])
  updatedAt         DateTime @updatedAt

  // The daily Holy Hour alarm (03:00 and 15:00, Africa/Kampala — see
  // HOLY_HOUR_TIMES in lib/alarms.ts) is inbuilt and always on. It fires for
  // every active member except the Technical Lead. holyHourLastFiredAt stores
  // the UTC instant of the last occurrence that fired, so each one claims
  // atomically.
  holyHourLastFiredAt DateTime?
  // Last Kampala date (midnight local) on which the birthday sweep fired.
  // Same claim pattern as holyHourLastFiredAt — one marker, atomic, prevents
  // double-firing on the same day.
  birthdayLastFiredAt DateTime?
}

// ============================================================
// DISCUSSION & MESSAGING (members' comment section + private chats)
// ============================================================

model Post {
  id             String    @id @default(uuid())
  authorId       String
  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  isAnnouncement Boolean   @default(false)
  isPinned       Boolean   @default(false)
  comments       Comment[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Private 1:1 conversations between members (the Discussion section's chat).
// conversationKey is the sorted pair of participant ids ("a:b"), which makes
// find-or-create race-proof: two simultaneous "start a chat" taps can't create
// duplicate threads.
model Conversation {
  id              String                    @id @default(uuid())
  conversationKey String                    @unique
  participants    ConversationParticipant[]
  messages        Message[]
  createdAt       DateTime                  @default(now())
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Read cursor for unread badges: messages after this are "unread" to this user.
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ============================================================
// EVENTS / CALENDAR + REMINDERS
// ============================================================

model Event {
  id          String          @id @default(uuid())
  title       String
  description String?
  type        EventType       @default(OTHER)
  startTime   DateTime
  endTime     DateTime?
  location    String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  attendees   EventAttendee[]
  reminders   Reminder[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model EventAttendee {
  id         String     @id @default(uuid())
  eventId    String
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvpStatus RsvpStatus @default(ATTENDING)
  createdAt  DateTime   @default(now())

  @@unique([eventId, userId])
}

model Reminder {
  id        String   @id @default(uuid())
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  remindAt  DateTime
  isSent    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([remindAt, isSent])
}

// ============================================================
// MEETINGS (group video / audio calls, prayer meetings)
// ============================================================

model Meeting {
  id                    String               @id @default(uuid())
  title                 String
  description           String?
  type                  MeetingType          @default(VIDEO)
  startsAt              DateTime
  endsAt                DateTime?
  meetingLink           String?
  location              String? // physical venue or "Zoom link" etc
  // True for system-created Holy Hour calls (spawned automatically by the
  // alarm sweep at each Holy Hour time). Any ACTIVE member other than the
  // Technical Lead may join these without being an explicit invitee.
  isAuto                Boolean              @default(false)
  // How long before startsAt the reminder fires (0 = at start time). The
  // meeting reminder is a distinct path from the daily Holy Hour alarm: one
  // `notified` flag per meeting claims it atomically so no reminder sends
  // twice, regardless of how many sweeps (interval, cron, poll) run.
  reminderMinutesBefore Int                  @default(15)
  notified              Boolean              @default(false)
  createdById           String?
  createdBy             User?                @relation(fields: [createdById], references: [id])
  // Music: starts playing for everyone on join; Patron / Chairperson can
  // toggle `musicPlaying` for the room. Default true so newly-spawned auto
  // Holy Hour calls play by default.
  musicPlaying          Boolean              @default(true)
  musicPausedAt         DateTime?
  musicPausedById       String?
  musicPausedBy         User?                @relation("MeetingMusicPausedBy", fields: [musicPausedById], references: [id])
  // End-of-call state. `endedAt IS NOT NULL` is the single source of truth
  // for "the room is closed" — set by a leader's End Call or by the
  // auto-end endpoint when the clock hits endsAt.
  endedAt               DateTime?
  endedById             String?
  endedBy               User?                @relation("MeetingEndedBy", fields: [endedById], references: [id])
  participants          MeetingParticipant[]
  signals               MeetingSignal[]
  sessions              MeetingSession[]
  attendances           MeetingAttendance[]
  holyHourCallLogs      HolyHourCallLog[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model MeetingParticipant {
  id        String    @id @default(uuid())
  meetingId String
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime?
  leftAt    DateTime?

  @@unique([meetingId, userId])
}

// WebRTC signaling queue: point-to-point offers/answers/ICE between call
// sessions, consumed (deleted) by the recipient's next poll. `toSessionId`
// addresses one browser session; broadcast join/leave is derived from
// MeetingSession presence instead, so no broadcast messages are needed.
model MeetingSignal {
  id            String   @id @default(cuid())
  meetingId     String
  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  fromSessionId String
  toSessionId   String
  type          String // "offer" | "answer" | "ice"
  payload       Json
  createdAt     DateTime @default(now())

  @@index([meetingId, toSessionId, createdAt])
}

// Live call presence: one row per joined browser session (sessionId). Created
// on join, deleted on leave. The room polls this alongside its signals.
model MeetingSession {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@index([meetingId])
}

// Historical attendance log for meetings (Holy Hour calls and any future
// manual meetings). One row per (meeting, user, attendance-burst): a user
// who joins, leaves, and rejoins the same meeting gets one row per
// attendance burst, summed in the UI to show "total time in call".
//
// Inserted on join with `leftAt` NULL and `durationSeconds` 0; updated on
// leave with `leftAt = now()` and `durationSeconds` recomputed from the
// latest `joinedAt`. Never deleted by the app — the meeting's
// `onDelete: Cascade` cleans up if the meeting itself is removed.
//
// Indexed on (meetingId, userId) for the per-meeting attendance view, and
// on (userId, joinedAt) for any future "my attendance" view.
model MeetingAttendance {
  id              String    @id @default(uuid())
  meetingId       String
  meeting         Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  // Wall-clock duration of this attendance burst. Filled on leave. NULL
  // while the user is still in the call.
  durationSeconds Int?

  @@index([meetingId, userId])
  @@index([userId, joinedAt])
}

// ============================================================
// PRAYER RESOURCES (Novena, Chaplet, Rosary, Holy Rosary)
// ============================================================

model PrayerResource {
  id        String     @id @default(uuid())
  title     String
  type      PrayerType @default(OTHER)
  dayNumber Int? // e.g. Novena day 1-9
  content   String?
  imageUrl  String?
  sourceUrl String? // link to the official Divine Mercy Catholic website
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// ============================================================
// ANNOUNCEMENTS & DAILY MESSAGES (synced from the Divine Mercy website)
// ============================================================

model Announcement {
  id          String   @id @default(uuid())
  title       String
  body        String
  imageUrl    String?
  sourceUrl   String?
  publishedAt DateTime @default(now())
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// NOTIFICATIONS & DEVICE TOKENS
// ============================================================

model Notification {
  id           String                 @id @default(uuid())
  title        String
  body         String
  type         NotificationType       @default(ANNOUNCEMENT)
  targetRole   Role? // null = send to all members
  link         String? // deep link, e.g. "/events/<id>"
  scheduledFor DateTime?
  sentAt       DateTime?
  createdById  String?
  createdBy    User?                  @relation(fields: [createdById], references: [id])
  deliveries   NotificationDelivery[]
  createdAt    DateTime               @default(now())
}

model NotificationDelivery {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveredAt    DateTime     @default(now())
  readAt         DateTime?

  @@unique([notificationId, userId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique // web push: the subscription endpoint
  platform  String   @default("android") // "android" | "ios" | "web"
  p256dh    String? // web push subscription key (required for sending)
  authKey   String? // web push subscription auth secret (required for sending)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// HOLY HOUR CALL LOG (per-member delivery outcome + retry state)
// ============================================================
// One row per (meeting, member) for auto-created Holy Hour calls. Written by
// the alarm sweep (lib/alarms.ts) right after it attempts the call push, and
// re-written by the retry pass when a FAILED row is retried.
//
// Why a dedicated table instead of a column on NotificationDelivery:
// NotificationDelivery means "this notification is in the member's in-app
// inbox", which is true for members with no push subscription at all (they
// still read it in the app). Push delivery is a different fact with a
// different failure mode, so it gets its own row. Keeping it separate also
// means the shared notification path for birthdays and event reminders is
// untouched.
model HolyHourCallLog {
  id            String             @id @default(uuid())
  meetingId     String
  meeting       Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        HolyHourCallStatus @default(PENDING)
  // Sweep attempts made (not per-device). Capped by
  // HOLY_HOUR_CALL_MAX_ATTEMPTS in lib/alarms.ts.
  attempts      Int                @default(0)
  // Cumulative device-level counters: pushes the push service accepted, and
  // pushes that errored.
  delivered     Int                @default(0)
  failures      Int                @default(0)
  lastAttemptAt DateTime?
  // Last error message seen, so a failing member is diagnosable without
  // server logs (Vercel function logs expire).
  lastError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Idempotency: concurrent sweeps converge on one row per member per call.
  @@unique([meetingId, userId])
  // Drives the retry query: FAILED rows under the attempt cap, oldest first.
  @@index([status, lastAttemptAt])
  @@index([meetingId])
}

// ============================================================
// SESSIONS (DB-backed, device-bound)
// ============================================================
// One row per (phoneNumber, deviceId) login. The cookie carries the
// opaque `id`; every protected request looks up the row and checks
// `deviceId` matches the `dm_device` cookie + `revokedAt IS NULL` +
// `expiresAt > now()`. Logout sets `revokedAt`; the row stays for
// audit. New device → new session; same phone on a new device does
// NOT invalidate the old device's session.
//
// `phoneNumber` is denormalized — purely for audit / future admin
// tooling, never used for auth (the join is `Session.userId` →
// `User.id`).
model Session {
  id          String    @id // opaque UUIDv4, the cookie value
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The dm_device cookie value at the time of login. Every protected
  // request verifies the current dm_device cookie still matches this
  // string; a mismatch = the cookie was copied to another device, deny.
  deviceId    String
  // Audit only — same comment as `phoneNumber` below.
  phoneNumber String
  userAgent   String?
  createdAt   DateTime  @default(now())
  // Updated on every successful getSessionUser (with a 60s debounce).
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
}
