# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"

# Web Push (VAPID). Generate locally with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# All three must be set for the Holy Hour call to ring on a closed phone.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A mailto: or https: URL identifying who the push is from.
VAPID_SUBJECT="mailto:admin@example.com"

# REQUIRED for the Holy Hour alarm to ring at all in production.
#
# Nothing rings unless something runs the alarm sweep on a schedule, and a
# serverless host has no timer of its own. Set this secret, then point an
# external scheduler at the route once a minute:
#
#   GET https://<your-app>/api/cron/alarms?token=<CRON_SECRET>
#   or POST the same URL with:  Authorization: Bearer <CRON_SECRET>
#
# Vercel's built-in cron cannot do this on Hobby: that plan allows cron jobs
# only once per day with up to an hour of drift, which is useless for a 03:00
# Holy Hour (and a more frequent expression fails the deployment). Per-minute
# crons need a paid plan. See README.md for the free setup.
#
# Without this secret the route answers 503 and never sweeps.
CRON_SECRET=""

# Session security now lives in the Session table (DB-backed, device-bound).
# The HTTP cookie carries an opaque row id, NOT a JWT — there's no signing
# secret to rotate. Logout sets `revokedAt` on the row and the cookie value
# becomes useless immediately.
